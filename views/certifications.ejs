<!-- certifications.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/images/favicon.png" />
  <title>Adhav's Portfolio</title>
  <meta charset="UTF-8">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- reuse your existing navbar include / markup -->
  <nav class="navbar navbar-expand-lg custom-nav">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><img src="/images/logo.png" alt="Adhav Logo" class="logo-img"></a>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="projectsDropdown" role="button" data-bs-toggle="dropdown">
              Projects
            </a>
            <ul class="dropdown-menu" aria-labelledby="projectsDropdown">
              <li><a class="dropdown-item" href="/coding">Coding</a></li>
              <li><a class="dropdown-item" href="/design">Design</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="/certifications">Certifications</a></li>
          <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- HERO (reuse your coding-wallpaper style so it matches) -->
  <section class="coding-wallpaper">
    <div>
      <h1>Certifications</h1>
      <p>Milestones and credentials I’ve earned along the way.</p>
    </div>
  </section>

  <!-- EXPERIENCE JOURNEY -->
  <section class="cert-journey">
    <div class="cert-journey__container">
        <div class="cert-journey__left">
        <div id="certJourneyCarousel" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner" id="certJourneyCarouselInner">
            <!-- slides injected by JS -->
            </div>
        
            <button class="carousel-control-prev" type="button" data-bs-target="#certJourneyCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Previous</span>
            </button>
        
            <button class="carousel-control-next" type="button" data-bs-target="#certJourneyCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Next</span>
            </button>
        </div>
        </div>          

      <div class="cert-journey__right">
        <h2>Experience Journey</h2>

        <div class="cert-journey__list">
            <button
            class="cert-journey__card is-active"
            type="button"
            data-images='["/images/YCLP1.jpeg",
            "/images/YCLP2.jpeg","/images/YCLP3.jpeg", 
            "/images/YCLP4.jpeg", "/images/YCLP5.jpeg", 
            "/images/YCLP6.jpeg", "/images/YCLP7.jpeg",
            "/images/YCLP8.jpeg", "/images/YCLP9.jpeg",
            "/images/YCLP10.jpeg", "/images/YCLP11.jpeg"]'>
            <h4>Youth Corps Programme</h4>
            <p class="muted">September 2025 - Present</p>
            <p>Led community initiatives and worked with partners on youth engagement programmes.</p>
          </button>
          
          <button
            class="cert-journey__card"
            type="button"
            data-images='["/images/MX1.jpeg","/images/MX2.jpeg", "/images/MX3.jpeg", "/images/MX4.jpeg"]'>
            <h4>Mission X</h4>
            <p class="muted">June 2025</p>
            <p>Created visual assets, posters, and editorial layouts for school initiatives.</p>
          </button>          

          <button class="cert-journey__card" data-image="/images/experience3.jpg" type="button">
            <h4>Development Projects</h4>
            <p class="muted">2024–2026</p>
            <p>Built full-stack apps and mobile projects with a focus on UX and usability.</p>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- CERTS GRID -->
  <section class="cert-grid">
    <div class="cert-grid__container">
      <h2>Certificates</h2>
      <p class="cert-grid__subtitle">Click a certificate to preview.</p>

      <div class="cert-grid__cards">
        <div class="cert-card" role="button" tabindex="0" onclick="openCertModal('cert1Modal')">
          <img src="/images/cert1-thumb.jpg" alt="Certificate thumbnail">
          <div class="cert-card__text">
            <h4>Certificate Name</h4>
            <p class="muted">Issuer • 2025</p>
          </div>
        </div>

        <div class="cert-card" role="button" tabindex="0" onclick="openCertModal('MXModal')">
          <img src="/images/MX Cert.jpg" alt="Certificate thumbnail">
          <div class="cert-card__text">
            <h4>Mission X Certificate</h4>
            <p class="muted">Youth Corps Singapore • 2025</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CERT MODALS (simple) -->
  <div id="MXModal" class="modal-overlay" onclick="closeCertModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()">
      <button class="close-btn" onclick="closeCertModal()">×</button>
      <div class="modal-content">
        <div class="modal-video">
            <div class="pdf-viewer" data-pdf="/pdf/MX.pdf">
              <div class="pdf-toolbar">
                <button type="button" class="pdf-btn pdf-prev">‹</button>
          
                <span class="pdf-page">
                  Page <span class="pdf-page-num">1</span> /
                  <span class="pdf-page-count">?</span>
                </span>
          
                <button type="button" class="pdf-btn pdf-next">›</button>
              </div>
          
              <canvas class="pdf-canvas"></canvas>
            </div>
          </div>          
        <div class="modal-info">
          <h1>Certificate Name</h1>
          <p class="modal-date">Youth Corps Singapore • 2025</p>
          <p class="modal-description">What you learned / why it matters (1–2 lines).</p>

          <div class="modal-link">
            <a class="modal-link-btn" href="/pdf/MX.pdf" target="_blank" rel="noopener noreferrer">Open PDF →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="MXModal2" class="modal-overlay" onclick="closeCertModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()">
      <button class="close-btn" onclick="closeCertModal()">×</button>
      <div class="modal-content">
        <div class="modal-video">
          <!-- you can use your pdf viewer here OR a simple image -->
          <img src="/images/cert1-full.jpg" alt="Certificate full view" style="max-width:100%; border-radius:18px;">
        </div>
        <div class="modal-info">
          <h1>Certificate Name</h1>
          <p class="modal-date">Issuer • 2025</p>
          <p class="modal-description">What you learned / why it matters (1–2 lines).</p>

          <div class="modal-link">
            <a class="modal-link-btn" href="/pdf/cert1.pdf" target="_blank" rel="noopener noreferrer">Open PDF →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Journey image swap
    document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll(".cert-journey__card");
    const inner = document.getElementById("certJourneyCarouselInner");
    const carouselEl = document.getElementById("certJourneyCarousel");

    function buildSlides(images = []) {
      inner.innerHTML = "";

      images.forEach((src, i) => {
        const item = document.createElement("div");
        item.className = "carousel-item" + (i === 0 ? " active" : "");
        item.innerHTML = `
          <img src="${src}" class="d-block w-100 cert-journey__slide" alt="Experience image ${i+1}">
        `;
        inner.appendChild(item);
      });

      // reset carousel back to first slide
      const instance = bootstrap.Carousel.getInstance(carouselEl) || new bootstrap.Carousel(carouselEl, { interval: false });
      instance.to(0);
    }

    function setActive(card) {
      cards.forEach(c => c.classList.remove("is-active"));
      card.classList.add("is-active");

      const images = JSON.parse(card.dataset.images || "[]");
      buildSlides(images);
    }

    // init using the active card
    const first = document.querySelector(".cert-journey__card.is-active") || cards[0];
    if (first) setActive(first);

    cards.forEach(card => card.addEventListener("click", () => setActive(card)));
  });

    // Modal open/close
    function openCertModal(id) {
        const modal = document.getElementById(id);
        modal.style.display = "flex";
        document.body.style.overflow = "hidden";

        // IMPORTANT: initialize PDF after modal is visible
        if (window.initPdfInModal) {
            requestAnimationFrame(() => {
            window.initPdfInModal(modal);
            });
        }
        }
    function closeCertModal(e){
      if(!e || e.target.classList.contains("modal-overlay")){
        document.querySelectorAll(".modal-overlay").forEach(m => m.style.display = "none");
        document.body.style.overflow = "";
      }
    }
  </script>
<!-- PDF.js (library) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<!-- Your viewer (uses pdfjsLib) -->
<script src="/js/pdfViewer.js"></script>
  

</body>
</html>
