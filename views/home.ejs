<div class="skill-modal" id="skillModal" aria-hidden="true">
  <div class="skill-modal__backdrop" data-close="true"></div>

  <div class="skill-modal__content" role="dialog" aria-modal="true" aria-labelledby="skillModalTitle">
    <button class="skill-modal__close" type="button" aria-label="Close" data-close="true">✕</button>

    <div class="skill-modal__header">
      <div class="skill-modal__logo">
        <img id="skillModalImg" src="" alt="">
      </div>

      <div class="skill-modal__titleblock">
        <h3 id="skillModalTitle"></h3>
        <div class="skill-modal__meta">
          <span class="pill" id="skillModalYear"></span>
          <span class="pill" id="skillModalLevel"></span>
        </div>
      </div>
    </div>

    <p class="skill-modal__desc" id="skillModalDesc"></p>

    <div class="skill-modal__section">
      <h4>Projects I used it in</h4>
      <p id="skillModalUsed"></p>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("skillModal");
  const tiles = document.querySelectorAll(".skill-tile");

  const modalTitle = document.getElementById("skillModalTitle");
  const modalYear = document.getElementById("skillModalYear");
  const modalLevel = document.getElementById("skillModalLevel");
  const modalUsed = document.getElementById("skillModalUsed");
  const modalDesc = document.getElementById("skillModalDesc");
  const modalImg = document.getElementById("skillModalImg");

  let lastFocusedEl = null;

  function openModalFromTile(tile) {
    lastFocusedEl = document.activeElement;

    const skill = tile.dataset.skill || "Skill";
    const year = tile.dataset.year || "—";
    const level = tile.dataset.level || "—";
    const used = tile.dataset.used || "—";
    const desc = tile.dataset.desc || "";
    const img = tile.dataset.img || "";

    modalTitle.textContent = skill;
    modalYear.textContent = `Skill attained: ${year}`;
    modalLevel.textContent = `Level: ${level}`;
    modalUsed.innerHTML = tile.dataset.usedHtml || used;
    modalDesc.textContent = desc;

    modalImg.src = img;
    modalImg.alt = `${skill} logo`;

    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden"; // stop background scroll

    // Focus close button for accessibility
    const closeBtn = modal.querySelector(".skill-modal__close");
    closeBtn.focus();
  }

  function closeModal() {
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";

    if (lastFocusedEl) lastFocusedEl.focus();
  }

  tiles.forEach(tile => {
    tile.addEventListener("click", () => openModalFromTile(tile));

    // allow Enter/Space to open (keyboard)
    tile.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openModalFromTile(tile);
      }
    });
  });

  // close when clicking backdrop or close button
  modal.addEventListener("click", (e) => {
    const shouldClose = e.target.dataset.close === "true";
    if (shouldClose) closeModal();
  });

  // close on ESC
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal.classList.contains("is-open")) {
      closeModal();
    }
  });
</script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const imgEl = document.getElementById("journeyImage");
    const cards = document.querySelectorAll(".journey-content");

    function setActive(card) {
      const newSrc = card.dataset.image;
      if (!newSrc) return;

      // Swap image
      imgEl.classList.add("journey-photo-fade");
      setTimeout(() => {
        imgEl.src = newSrc;
      }, 120);

      // Remove active from all, add to clicked
      cards.forEach(c => c.classList.remove("journey-active"));
      card.classList.add("journey-active");
    }

    // When image loads, fade back in
    imgEl.addEventListener("load", () => {
      imgEl.classList.remove("journey-photo-fade");
    });

    // Click + keyboard support (Enter/Space)
    cards.forEach(card => {
      card.addEventListener("click", () => setActive(card));
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          setActive(card);
        }
      });
    });
  });
</script>



