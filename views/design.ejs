    <!-- FULLSCREEN IMAGE VIEWER (ONLY ONCE PER PAGE) -->
    <div id="lightbox" class="lightbox" onclick="closeLightbox(event)">
      <button class="lightbox-close" type="button" onclick="closeLightbox()">×</button>

      <button class="nav prev" type="button" onclick="prevImage()">‹</button>

      <img id="lightbox-img" src="" alt="Fullscreen project screenshot" />

      <button class="nav next" type="button" onclick="nextImage()">›</button>
    </div>
          
          <script>
            function openModal(id) {
                const modal = document.getElementById(id);
                modal.style.display = "flex";

                if (window.initPdfInModal) {
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                    window.initPdfInModal(modal);
                    });
                });
                }
            }
                      
            function closeModal(e) {
              if (!e || e.target.classList.contains("modal-overlay")) {
                document.querySelectorAll(".modal-overlay").forEach((modal) => {
                  modal.style.display = "none";
                });
              }
            }
            </script>
          <script src="/js/lightbox.js"></script>

