  <!-- FULLSCREEN IMAGE VIEWER (from old projectModal partial) -->
  <div id="lightbox" class="lightbox" onclick="closeLightbox(event)">
    <button class="lightbox-close" onclick="closeLightbox()">×</button>

    <button class="nav prev" onclick="prevImage()">‹</button>

    <img id="lightbox-img" src="" alt="Lightbox image" />

    <button class="nav next" onclick="nextImage()">›</button>
  </div>

  <!-- MODAL CONTROL SCRIPT -->
<!-- Add this to coding.ejs after the modal HTML -->
<script>
  // Gallery functionality for modals
  document.addEventListener('DOMContentLoaded', function() {
      // Add click handlers to modal gallery images
      document.querySelectorAll('.modal-gallery img').forEach(img => {
          img.addEventListener('click', function() {
              const allImages = Array.from(this.parentElement.querySelectorAll('img'))
                  .map(img => img.src);
              const currentIndex = allImages.indexOf(this.src);
              openLightbox(allImages, currentIndex);
          });
      });
  });

  // Ensure video plays correctly in modals
  document.querySelectorAll('.modal-overlay').forEach(modal => {
      modal.addEventListener('click', function(e) {
          if (e.target === this) {
              // Pause any playing videos when closing modal
              this.querySelectorAll('video').forEach(video => {
                  video.pause();
              });
              this.style.display = 'none';
          }
      });
  });
</script>

  <!-- Lightbox behaviour (you already had this) -->
  <script src="/js/lightbox.js"></script>
</body>
