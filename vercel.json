{
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/api/index.js"
      }
    ],
    "functions": {
      "api/index.js": {
        "maxDuration": 10
      }
    },
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ]
  }